# Staging environment for the QA Smoke stand.
#
# These are NON-SECRET, throwaway values safe to commit: the staging stand is
# ephemeral and rebuilt from scratch on every deploy. NEVER put real
# production secrets here. deploy_staging.sh copies this file to .env.staging
# (gitignored) when one is not already present, so the stand boots unattended.
#
# Keep this separate from the orchestrator's own .env (Pydantic Settings in
# tools/orchestrator/orchestrator/config.py) — different concern, different file.

# --- Postgres ---
POSTGRES_DB=mes_staging
POSTGRES_USER=mes
POSTGRES_PASSWORD=staging-only-not-secret

# --- Django ---
# Throwaway key for staging ONLY. Generate a real one for any real deployment.
DJANGO_SECRET_KEY=insecure-staging-key-not-for-production
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,app,web
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080

# --- Web tier ---
# Host port the served app is published on. Fixed so QA Smoke knows the URL.
STAGING_WEB_PORT=8080
