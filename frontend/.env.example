# Frontend environment template (NSG-19).
# Copy to `.env.local` and adjust. Never commit real values.

# Base URL the typed API client calls. Relative by default so the Vite dev
# proxy (and the production reverse proxy) forwards it same-origin, which keeps
# Django session + CSRF cookies working. Override only for split-origin setups.
VITE_API_BASE_URL=/api

# Origin the Vite dev server proxies /api to. Points at the local Django/DRF
# backend; change per developer/environment without touching code (AC-5).
VITE_API_PROXY_TARGET=http://localhost:8000

# Dev server / Playwright port.
VITE_DEV_PORT=5173
