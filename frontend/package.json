{
  "name": "nsg-mes-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "NSG MES operator/supervisor frontend (React 18 + Vite + TypeScript).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "msw:init": "msw init ./public --save"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.100.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.16.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.19.19",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/coverage-v8": "^4.1.0",
    "jsdom": "^29.0.0",
    "msw": "^2.14.0",
    "typescript": "~5.7.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
