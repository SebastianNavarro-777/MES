{
  "name": "nsg-mes-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "NSG MES React frontend — foundational scaffold (NSG-19).",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "gen:api": "openapi-typescript ./openapi/schema.json --output ./src/api/generated/schema.d.ts --root-types"
  },
  "dependencies": {
    "@tanstack/react-query": "5.59.16",
    "openapi-fetch": "0.12.2",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.13.0",
    "@playwright/test": "1.48.2",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.6.2",
    "@testing-library/react": "16.0.1",
    "@types/node": "22.7.5",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "eslint": "9.13.0",
    "globals": "15.11.0",
    "jsdom": "25.0.1",
    "openapi-typescript": "7.4.2",
    "typescript": "5.6.3",
    "typescript-eslint": "8.12.2",
    "vite": "5.4.10",
    "vitest": "2.1.4"
  }
}
