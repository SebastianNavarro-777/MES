# Staging image for the React bundle, served by nginx.
# Multi-stage: build the Vite bundle with Node, serve the static output with
# nginx, which also reverse-proxies /healthz and /api to the Django app.

# --- Stage 1: build the bundle --------------------------------------------
FROM node:20-alpine AS build
WORKDIR /build

COPY frontend/package.json /build/package.json
# No lockfile committed for the skeleton; install resolves from package.json.
RUN npm install

COPY frontend/ /build/
RUN npm run build

# --- Stage 2: serve -------------------------------------------------------
FROM nginx:1.27-alpine
ENV TZ=UTC

COPY deploy/staging/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /build/dist /usr/share/nginx/html

EXPOSE 80

# Container-level health: nginx is up and serving (independent of the app so
# that a backend outage is attributed to the app service, not the web tier).
HEALTHCHECK --interval=10s --timeout=5s --start-period=10s --retries=6 \
    CMD wget --quiet --tries=1 --spider http://127.0.0.1/nginx-health || exit 1
