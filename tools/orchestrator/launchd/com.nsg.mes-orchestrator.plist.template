<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
  macOS launchd template for the NSG MES orchestrator.

  Replace {{HOME_PATH}} and {{USER}} with concrete values, copy to
    ~/Library/LaunchAgents/com.nsg.mes-orchestrator.plist
  and load with:
    launchctl load ~/Library/LaunchAgents/com.nsg.mes-orchestrator.plist
-->
<dict>
    <key>Label</key>
    <string>com.nsg.mes-orchestrator</string>

    <key>UserName</key>
    <string>{{USER}}</string>

    <key>WorkingDirectory</key>
    <string>{{HOME_PATH}}/MES/MES/tools/orchestrator</string>

    <key>ProgramArguments</key>
    <array>
        <string>{{HOME_PATH}}/MES/MES/.venv/bin/python</string>
        <string>-m</string>
        <string>orchestrator</string>
        <string>run-all</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>{{HOME_PATH}}/MES/MES/.venv/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>StandardOutPath</key>
    <string>{{HOME_PATH}}/MES/MES/.orchestrator-state/logs/launchd-stdout.log</string>

    <key>StandardErrorPath</key>
    <string>{{HOME_PATH}}/MES/MES/.orchestrator-state/logs/launchd-stderr.log</string>
</dict>
</plist>
