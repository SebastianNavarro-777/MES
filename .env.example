# Copy to .env and fill with real values. NEVER commit .env.

# --- Linear ---
LINEAR_API_KEY=
LINEAR_TEAM_ID=
# Optional. If set, the seed script and the Architect agent assign new
# tickets to this project so they show up in your project view. Leave
# empty to land tickets at team level (visible only in "All issues").
LINEAR_PROJECT_ID=

# --- GitHub ---
GITHUB_TOKEN=
GITHUB_REPO=

# --- Claude Code ---
# Path to claude CLI binary. Leave empty to use whatever is on $PATH.
CLAUDE_CONFIG_PATH=

# --- Worktrees ---
# Absolute path where the orchestrator creates per-ticket git worktrees.
WORKTREES_DIR=

# --- Concurrency / triggers ---
MAX_CONCURRENT_WORKERS=2
AUDITOR_PR_THRESHOLD=5
GARDENER_LEARNING_THRESHOLD=10
GARDENER_PR_SAFETY_THRESHOLD=50
ARCHITECT_BACKLOG_THRESHOLD=5
AGENT_COOLDOWN_MINUTES=30
